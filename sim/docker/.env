
# Container user = host user (`id -u`, `id -g`): files written into the mounted repo and BAGS_DIR are owned by you.
UID=1000
GID=1000

# ROS 2 domain of the ros container (becomes ROS_DOMAIN_ID inside it). Non-zero, so a host ROS process on the
# default domain 0 never joins. Not named ROS_DOMAIN_ID here: the host shell exports ROS_DOMAIN_ID=0 (~/.bashrc)
# and Compose lets the shell override .env.
SIM_ROS_DOMAIN_ID=42

# Where bags are written. /home has ~3 GB free on this laptop, / has ~90 GB: keep bags on /var/tmp
# (recording is ~8 MB/s at 20 Hz sweeps; check `df -h` before recording).
BAGS_DIR=/var/tmp/brightdrive_bags
