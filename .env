# Read by `docker compose` from the repo root. A name exported by the shell wins over the value here.

# Container user = host user (`id -u`, `id -g`): files written into the mounted repo, BAGS_DIR and MAPS_DIR are
# owned by you.
UID=1000
GID=1000

# ROS 2 domain of every ROS container. Non-zero, so a host ROS process on the default domain 0 never joins.
# The host shell must not export ROS_DOMAIN_ID itself: Compose would take the shell's value instead of this one.
ROS_DOMAIN_ID=42

# Where bags are written. /home has ~3 GB free on this laptop, / has ~90 GB: keep bags on /var/tmp
# (recording is ~8 MB/s at 20 Hz sweeps; check `df -h` before recording).
BAGS_DIR=/var/tmp/brightdrive_bags

# Where built maps (.pcd) are kept, outside the repo for the same reason.
MAPS_DIR=/var/tmp/brightdrive_maps
