<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>brightdrive_mapping</name>
  <version>0.1.0</version>
  <description>
    Mapping backend for BrightDrive: keyframes, GTSAM pose graph, GNSS and loop-closure factors, map assembly.
    FAST-LIO (OmerMersin/FAST_LIO_OUSTER @ 8ffac51) is the upstream LiDAR-inertial odometry; it is cloned unmodified
    in the Docker mapping stage and is not part of this package.
  </description>
  <maintainer email="abdalrahmangamal1999@gmail.com">Abdalrhman Gamal</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- mapping_core (no ROS) -->
  <depend>eigen</depend>
  <depend>gtsam</depend>
  <depend>libpcl-all-dev</depend>

  <!-- backend_node -->
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>
  <depend>pcl_conversions</depend>

  <!-- launch/backend_replay.launch.py -->
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
