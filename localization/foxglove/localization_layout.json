  "globalVariables": {},
  "userNodes": {
    "init_phase": {
      "name": "init_phase",
      "sourceCode": "// The first word of the localizer's init status (\"waiting\", \"searching\", \"confirming\", \"done\"), for the\n// State Transitions panel: the full strings carry reasons and numbers and would make one band per value.\nimport { Input } from \"./types\";\n\nexport const inputs = [\"/localization/status\"];\nexport const output = \"/foxglove_script/init_phase\";\n\ntype Output = { data: string };\n\nexport default function script(event: Input<\"/localization/status\">): Output | undefined {\n  const status = event.message.status[0];\n  if (status == undefined) {\n    return undefined;\n  }\n  const init = status.values.find((kv) => kv.key === \"init\");\n  if (init == undefined) {\n    return undefined;\n  }\n  return { data: init.value.split(\" \")[0] ?? init.value };\n}\n"
    }
  },
