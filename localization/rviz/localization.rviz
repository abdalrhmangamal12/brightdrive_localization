Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 30; 30; 34
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 10
      Plane Cell Count: 100
      Color: 90; 90; 90
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/PointCloud2
      Name: Map (viewer copy)
      Enabled: true
      Topic:
        Value: /localization/map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Style: Points
      Size (Pixels): 1
      Color Transformer: AxisColor
      Axis: Z
      Use rainbow: true
      Alpha: 0.6
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Aligned scan
      Enabled: true
      Topic:
        Value: /localization/debug/aligned_scan
        Depth: 1
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 170; 0
      Alpha: 1
      Decay Time: 0
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: true
      Marker Scale: 3
      Update Interval: 0
      Frames:
        All Enabled: true
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: Pose + covariance
      Enabled: true
      Topic:
        Value: /localization/pose
        Depth: 5
        Reliability Policy: Reliable
        History Policy: Keep Last
      Shape: Arrow
      Color: 0; 200; 255
      Shaft Length: 3
      Shaft Radius: 0.3
      Head Length: 1
      Head Radius: 0.6
      Covariance:
        Value: true
        Position:
          Value: true
          Scale: 3
          Color: 0; 200; 255
          Alpha: 0.4
        Orientation:
          Value: true
          Frame: Local
          Scale: 3
          Color: 255; 255; 127
          Alpha: 0.5
    - Class: rviz_default_plugins/Path
      Name: Path
      Enabled: true
      Topic:
        Value: /localization/path
        Depth: 1
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Line Style: Lines
      Line Width: 0.2
      Color: 0; 255; 120
      Alpha: 1
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
  Views:
    Current:
      Class: rviz_default_plugins/ThirdPersonFollower
      Name: Current View
      Target Frame: base_link
      Distance: 60
      Pitch: 0.9
      Yaw: 3.14
      Focal Point: 0; 0; 0
      Near Clip Distance: 0.01
Window Geometry:
  Width: 1400
  Height: 900
